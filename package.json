{
  "name": "notion-site",
  "version": "2.0.0",
  "private": true,
  "description": "The perfect toolkit for publishing Notion to website.",
  "author": "Jacques De SAGAN <jacquesde@sagan.me>",
  "repository": "sagan/notion-site",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "patch-package",
    "dev": "cross-env NODE_OPTIONS=\"--dns-result-order=ipv4first\" next dev",
    "build": "cross-env NODE_OPTIONS=\"--dns-result-order=ipv4first\" next build",
    "start": "next start",
    "lint": "next lint",
    "deploy": "vercel deploy",
    "deps": "run-s deps:*",
    "deps:update": "[ -z $GITHUB_ACTIONS ] && yarn add notion-client notion-types notion-utils react-notion-x || echo 'Skipping deps:update on CI'",
    "deps:link": "[ -z $GITHUB_ACTIONS ] && yarn link notion-client notion-types notion-utils react-notion-x || echo 'Skipping deps:link on CI'",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
    "test": "run-p test:*",
    "test:lint": "eslint '**/*.{ts,tsx}'",
    "test:prettier": "prettier '**/*.{js,jsx,ts,tsx}' --check"
  },
  "dependencies": {
    "@fisch0920/use-dark-mode": "^2.4.0",
    "@keyvhq/core": "^1.6.9",
    "@keyvhq/redis": "^1.6.10",
    "@react-icons/all-files": "^4.1.0",
    "@vercel/og": "^0.6.3",
    "classnames": "^2.5.1",
    "clipboard-copy": "^4.0.1",
    "date-fns": "^4.1.0",
    "expiry-map": "^2.0.0",
    "favicons": "^7.2.0",
    "fs-extra": "^11.2.0",
    "got": "^12.0.3",
    "isomorphic-unfetch": "^3.1.0",
    "ky": "^1.7.2",
    "lqip-modern": "^2.1.0",
    "mermaid": "^11.12.0",
    "next": "^16.4.6",
    "notion-client": "^8.0.8",
    "notion-types": "^8.0.8",
    "notion-utils": "^8.0.8",
    "p-map": "^7.0.2",
    "p-memoize": "^7.1.1",
    "prismjs": "^1.29.0",
    "quick-lru": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-ga4": "^2.1.0",
    "react-notion-x": "^8.0.8",
    "react-tweet": "^3.2.1",
    "react-use": "^17.4.2",
    "rss": "^1.2.2",
    "server-only": "^0.0.1",
    "stale-while-revalidate-cache": "^3.4.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "cross-env": "^7.0.2",
    "eslint": "9.15.0",
    "eslint-config-next": "^16.4.6",
    "npm-run-all": "^4.1.5",
    "npm-run-all2": "^7.0.1",
    "patch-package": "^8.0.0",
    "prettier": "3.10.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "cacheable-request": {
      "keyv": "npm:@keyvhq/core@~1.6.6"
    }
  },
  "prettier": {
    "printWidth": 120
  }
}
