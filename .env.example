# All of these environment vars must be defined either in your environment or in
# a local .env file in order to run this app.

# Required, redis URL
REDIS_URL=redis://127.0.0.1:6379

# Required. The admin token. Can be plaintext or "__sha256__<token-sha256>"
TOKEN=123456

# Optional. Key prefix in Redis. Defaults to "notion"
#REDIS_NAMESPACE=notion

# Optional. Cloudflare API info, used to purge CF cache from admin UI.
# CF API token with "Purge Cache" permission of the zone
#CLOUDFLARE_API_TOKEN=cfut_aabbccddeeff
# CF zone id
#CLOUDFLARE_ZONE_ID=aabbccddeeff

# Optional (only used in development environment). Comma-separated allowed origins for `next dev`.
#ALLOWED_DEV_ORIGINS=dev.example.com,*.example.com
